{
  "info": {
    "_postman_id": "9d9b4b13-7b0a-4c91-9d6b-2e93a94d0b71",
    "name": "Day 7 - API Integration Testing Practice",
    "description": "Practice collection for HTTP methods, response validation, JSON checks, and negative scenarios. Uses JSONPlaceholder public demo API; writes are simulated and are not persisted as a real database change.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - GET all posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "description": "Validate list endpoint and JSON response shape."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is JSON array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
              "pm.test('Array has items', function () { pm.expect(pm.response.json().length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET post by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Validate a specific resource."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Post has expected fields', function () { pm.expect(data).to.have.property('id'); pm.expect(data).to.have.property('title'); pm.expect(data).to.have.property('body'); });",
              "pm.test('Post ID matches variable', function () { pm.expect(String(data.id)).to.eql(pm.variables.get('postId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET posts by user ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts?userId={{userId}}"
          ]
        },
        "description": "Validate query filtering."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Response is an array', function () { pm.expect(data).to.be.an('array'); });",
              "pm.test('All posts belong to requested user', function () { pm.expect(data.every(p => String(p.userId) === pm.variables.get('userId'))).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - POST create post (simulated)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Day 7 integration practice\",\n  \"body\": \"Practice request for integration testing\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "JSONPlaceholder simulates create responses; it does not persist a real record."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.test('Response echoes submitted title', function () { pm.expect(data.title).to.eql('Day 7 integration practice'); });",
              "pm.test('Response contains an ID', function () { pm.expect(data).to.have.property('id'); });"
            ]
          }
        }
      ]
    },
