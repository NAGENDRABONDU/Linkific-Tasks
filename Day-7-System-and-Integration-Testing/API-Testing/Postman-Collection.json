    {
      "name": "08 - GET non-existent post",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/99999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "99999999"
          ]
        },
        "description": "JSONPlaceholder returns an empty object for unknown resource IDs; contract-specific APIs may return 404."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404 or documented empty response', function () { pm.expect([404, 200]).to.include(pm.response.code); });",
              "pm.test('No post data returned for missing ID', function () { const d = pm.response.json(); pm.expect(d).to.be.an('object'); pm.expect(Object.keys(d).length).to.eql(0); });"
            ]
          }
        }
      ]
    },
